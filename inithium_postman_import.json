					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// A freshly registered/logged-in user always has role 'user' (see Auth > Register), which grants no capabilities by default - users:managePermissions is deliberately excluded from every role's default bundle (owner-granted only), so this route's guard should reject it regardless of role.",
									"pm.test('Status code is 403 (default user lacks users:managePermissions capability)', () => pm.response.to.have.status(403));"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
