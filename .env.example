MONGO_URI=mongodb_config_uri
PORT=port_number
# Generate with: openssl rand -base64 48   (startup refuses anything shorter than 32 characters)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h

# "production" on any deployed host - hides error stack traces and makes WEB_ORIGIN mandatory
NODE_ENV=development
# Comma-separated browser origins allowed to call the API and open realtime sockets
WEB_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (Render: 1, local: 0) - drives per-visitor rate limits
TRUST_PROXY=0
# The one account allowed to claim site ownership automatically (on registration or at startup)
# while no owner exists. Leave unset once an owner exists.
OWNER_BOOTSTRAP_EMAIL=

# Stripe - test keys locally, live keys in production
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# false skips Stripe Tax entirely (no tax calculated or collected)
STRIPE_TAX_ENABLED=false

# Cloudflare Turnstile secret - only needed when the contact.captchaEnabled setting is on
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (S3-compatible) - every uploaded image (logo, home image, staff, programs,
# products, gallery) is stored here. Create an R2 API token with Object Read & Write on the bucket.
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=bucket_name
STORAGE_ACCESS_KEY_ID=r2_access_key_id
STORAGE_SECRET_ACCESS_KEY=r2_secret_access_key
# The bucket's public host - its r2.dev URL or a custom domain connected to the bucket
STORAGE_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
STORAGE_FORCE_PATH_STYLE=false
